# Easy Drive — environment variables
# Copy this file to `.env` and fill in your own Supabase project.
#
# Both URLs come from the Supabase dashboard (Project settings → Database →
# Connection string → Prisma). They differ only in port:
#   6543  transaction-mode pooler — every query the app runs
#   5432  session-mode pooler     — migrations, which need a real session
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signing key for the POS and Master session cookies.
# Optional but recommended — without it the key is derived from DATABASE_URL, so
# changing the database signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_SESSION_SECRET=""

# Shared key for POST /api/orders (the online-order ingestion endpoint).
# Leave empty on a shop-local machine; set it before the port is reachable from
# anywhere else, and have the caller send it as the X-Api-Key header.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ORDER_API_KEY=""
