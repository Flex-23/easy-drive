# Easy Drive — environment variables
# Copy this file to `.env` and fill in your own Supabase project.
#
# Both URLs come from the Supabase dashboard (Project settings → Database →
# Connection string → Prisma). Which one DATABASE_URL should use depends on
# where the app runs, and getting it wrong takes the site down:
#
#   port 6543, transaction pooler — for a HOST THAT SCALES (Vercel and the like).
#     Each request may land on a fresh instance with its own pool, so they must
#     be multiplexed. Always with pgbouncer=true and connection_limit=1.
#
#   port 5432, session pooler — for ONE LONG-RUNNING SERVER (the shop machine).
#     Faster, but Supabase allows only ~15 such clients for the whole project,
#     so cap connection_limit and never point a scaling host at it.
#
# DIRECT_URL is always 5432: migrations need a real session for advisory locks.

# On a host that scales (Vercel):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# On the shop's own machine:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=4"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signing key for the POS and Master session cookies.
# Optional but recommended — without it the key is derived from DATABASE_URL, so
# changing the database signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_SESSION_SECRET=""

# Shared key for POST /api/orders (the online-order ingestion endpoint).
# Leave empty on a shop-local machine; set it before the port is reachable from
# anywhere else, and have the caller send it as the X-Api-Key header.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ORDER_API_KEY=""

# Shared key for the print agent that runs beside the shop's printer, so the
# cloud copy of the app can print there (see print/README.md). The same value
# goes into print/config.json. While it is empty /api/print-jobs stays closed.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PRINT_AGENT_KEY=""
