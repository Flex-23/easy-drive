  "about": {
    "title": "Über Food Express",
    "tagline": "Kassensystem und Lieferdisposition für ein Restaurant",
    "systemTitle": "Das System",
    "systemText": "Food Express ist die Kasse und die Lieferzentrale eines Restaurants in einem Programm: Bestellungen aufnehmen, parken und fortsetzen, Kunden mit Adresse und Hinweis für den Fahrer führen, Bestellungen an Fahrer übergeben oder am Tresen kassieren, Kundenbeleg und Küchenbon drucken und am Ende des Tages abrechnen. Die Kasse spricht Deutsch, das Master-Panel für den Inhaber Arabisch — beide arbeiten auf derselben Datenbank.",
    "featuresTitle": "Was es kann",
    "features": {
      "orders": "Bestellungen für Lieferung und Abholung, mit Größen, Zusätzen und Küchennotizen",
      "customers": "Kundenkartei mit Telefonsuche, Adresse, Hinweis zur Adresse und Suche nach Straße oder Ortsteil",
      "drivers": "Bestellübersicht: Fahrer zuweisen, bar oder online kassieren, stornieren und wiederherstellen",
      "printing": "Kundenbeleg, Küchenbon und Adressetikett auf dem Bondrucker — auch aus der Cloud über den Druck-Agenten",
      "reports": "Tagesbericht und Fahrerabrechnungen auf Papier, Umsatzauswertung im Master-Panel",
      "master": "Master-Panel für Speisekarte, Preise, Benutzer und Umsatz"
    },
    "developerTitle": "Über den Entwickler",
    "developerName": "Baqir Majid",
    "developerText": "Food Express wurde von Baqir Majid entworfen und entwickelt — aus dem Alltag hinter dem Tresen heraus, nicht am Reißbrett. Jede Funktion ist entstanden, weil sie an der Kasse gefehlt hat: die Liefergebühr, die man pro Bestellung eintippt; der Hinweis, der dem Fahrer die richtige Klingel zeigt; der Bon, den man nicht drucken muss. Das Ziel ist ein Werkzeug, das im Stoßgeschäft nicht im Weg steht.",
    "contactTitle": "Kontakt",
    "contactText": "Fragen, Wünsche oder ein Fehler im System? Eine E-Mail genügt — Antwort kommt persönlich.",
    "writeEmail": "E-Mail schreiben",
    "copyEmail": "Adresse kopieren",
    "copied": "Kopiert",
    "version": "Version"
  }
